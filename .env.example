# ───────────────────────────────────────────────────────────────
# BlockCanvas 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# 실제 .env / .env.local 은 .gitignore 처리되어 커밋되지 않습니다.
# ───────────────────────────────────────────────────────────────

# [필수] 세션 서명용 비밀키 (HMAC-SHA256).
# 32자 이상의 강력한 무작위 값이어야 하며, 없거나 짧으면 앱이 fail-closed 로 throw 합니다.
# 생성 예시(Node):  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# [선택] 회원가입 기능 플래그. "true" 일 때만 셀프 회원가입을 허용합니다. (기본: 비활성)
ENABLE_SIGNUP=false

# [선택] 콘솔 로그 레벨: debug | info | warn | error | silent (미설정 시 debug=전체 출력).
# 운영에서 로그를 줄이려면 info/warn 으로, 끄려면 silent 로 설정.
# 클라이언트(브라우저) 로그까지 제어하려면 NEXT_PUBLIC_LOG_LEVEL 을 사용하세요.
LOG_LEVEL=debug

# [선택] Prisma CLI(마이그레이션) 용 데이터베이스 URL.
# 런타임 연결은 src/lib/prisma.ts 에서 ./dev.db 로 직접 설정됩니다(libsql 어댑터).
DATABASE_URL="file:./dev.db"

# ── DB 백업 스크립트(scripts/backup-db.mjs) 용 (선택) ──────────────
# BC_DB_PATH=./dev.db
# BC_BACKUP_DIR=./backups
# BC_BACKUP_LOG=./backups/backup.log
# BC_BACKUP_RETENTION=14
# BC_BROTLI_QUALITY=11
