# ───────────────────────────────────────────────────────────────
# BlockCanvas 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# 실제 .env / .env.local 은 .gitignore 처리되어 커밋되지 않습니다.
# ───────────────────────────────────────────────────────────────

# [필수] 세션 서명용 비밀키 (HMAC-SHA256).
# 32자 이상의 강력한 무작위 값이어야 하며, 없거나 짧으면 앱이 fail-closed 로 throw 합니다.
# 생성 예시(Node):  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# [선택] 회원가입 기능 플래그. "true" 일 때만 셀프 회원가입을 허용합니다. (기본: 비활성)
ENABLE_SIGNUP=false

# [선택] 콘솔 로그 레벨: debug | info | warn | error | silent (미설정 시 debug=전체 출력).
# 운영에서 로그를 줄이려면 info/warn 으로, 끄려면 silent 로 설정.
# 클라이언트(브라우저) 로그까지 제어하려면 NEXT_PUBLIC_LOG_LEVEL 을 사용하세요.
LOG_LEVEL=debug

# [선택] Prisma CLI(마이그레이션) 용 데이터베이스 URL.
# 런타임 연결은 src/lib/prisma.ts 에서 ./dev.db 로 직접 설정됩니다(libsql 어댑터).
DATABASE_URL="file:./dev.db"

# ── 마인크래프트 서버 연동 (MC_SER / BlockCanvasLink 플러그인) ──────
# 웹↔마크 서버 HMAC-SHA256 통신용. SECRET 은 플러그인 config.yml 의 shared-secret 과
# 반드시 동일해야 합니다(기본값 사용 시 위변조 방어 무력화 → 콘솔 경고 출력).
# 생성 예시:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 운영에서는 URL 을 Cloudflared 터널 HTTPS 도메인으로 교체하세요.
MINECRAFT_API_URL="http://localhost:25580"
MINECRAFT_API_SECRET=

# ── DB 백업 스크립트(scripts/backup-db.mjs) 용 (선택) ──────────────
# BC_DB_PATH=./dev.db
# BC_BACKUP_DIR=./backups
# BC_BACKUP_LOG=./backups/backup.log
# BC_BACKUP_RETENTION=14
# BC_BROTLI_QUALITY=11

# ── off-site 백업: Cloudflare R2 (scripts/upload-r2.mjs) ──────────
# 아래 R2_* 4개가 모두 채워져야 백업본이 R2로 업로드됩니다(비우면 로컬 백업만, 자동 skip).
# 발급: Cloudflare 대시보드 → R2 → 버킷 생성(비공개) → "Manage R2 API Tokens"(Object Read & Write)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=blockcanvas-backups
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   # 선택(미설정 시 ACCOUNT_ID로 자동 구성)
# 용량 80% 도달 알림 채널(선택). Discord 채널 → 연동 → 웹훅 URL.
# DISCORD_WEBHOOK_URL=
# R2_USAGE_ALERT_BYTES=8589934592        # 선택: 알림 임계(기본 8GiB = 무료 10GB의 80%)
# R2_UPLOAD_MIN_INTERVAL_HOURS=20        # 선택: off-site 업로드 최소 간격(기본 ~1회/일)
# 보존: R2 대시보드 Lifecycle 규칙으로 db/ 프리픽스 → 1825일(5년) 후 자동 삭제 설정
