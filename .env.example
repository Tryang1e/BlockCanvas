# ───────────────────────────────────────────────────────────────
# BlockCanvas 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# 실제 .env / .env.local 은 .gitignore 처리되어 커밋되지 않습니다.
# ───────────────────────────────────────────────────────────────

# [필수] 세션 서명용 비밀키 (HMAC-SHA256).
# 32자 이상의 강력한 무작위 값이어야 하며, 없거나 짧으면 앱이 fail-closed 로 throw 합니다.
# 생성 예시(Node):  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# [선택] 회원가입 킬스위치. "false" 일 때만 셀프 회원가입을 차단합니다. (기본: 활성)
# 이메일/비번 가입은 RESEND_API_KEY 가 설정돼야 인증 메일이 발송됩니다(미설정 시 가입 시 오류 안내).
# ENABLE_SIGNUP=false

# ── 이메일 발송 (Resend — 회원가입 이메일 인증) ──────────────────
# Resend(https://resend.com) API 키. 대시보드 → API Keys 에서 발급.
# ⚠️ 발신 도메인(craftopia.work)을 Resend 에 등록·DNS 검증해야 메일이 실제 전송됩니다.
RESEND_API_KEY=
# [선택] 발신자. 미설정 시 기본 'craftopia <noreply@craftopia.work>'. Resend 검증 도메인이어야 함.
# EMAIL_FROM="craftopia <noreply@craftopia.work>"

# [선택] 콘솔 로그 레벨: debug | info | warn | error | silent (미설정 시 debug=전체 출력).
# 운영에서 로그를 줄이려면 info/warn 으로, 끄려면 silent 로 설정.
# 클라이언트(브라우저) 로그까지 제어하려면 NEXT_PUBLIC_LOG_LEVEL 을 사용하세요.
LOG_LEVEL=debug

# [선택] Prisma CLI(마이그레이션) 용 데이터베이스 URL.
# 런타임 연결은 src/lib/prisma.ts 에서 ./dev.db 로 직접 설정됩니다(libsql 어댑터).
DATABASE_URL="file:./dev.db"

# ── 마인크래프트 서버 연동 (MC_SER / BlockCanvasLink 플러그인) ──────
# 웹↔마크 서버 HMAC-SHA256 통신용. SECRET 은 플러그인 config.yml 의 shared-secret 과
# 반드시 동일해야 합니다(기본값 사용 시 위변조 방어 무력화 → 콘솔 경고 출력).
# 생성 예시:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 운영에서는 URL 을 Cloudflared 터널 HTTPS 도메인으로 교체하세요.
MINECRAFT_API_URL="http://localhost:25580"
MINECRAFT_API_SECRET=
# [선택] MC 서버 "Server" 폴더의 절대경로. 웹이 마크 서버 디스크를 직접 읽는 곳(스키매틱 클라우드·블루프린트
#   갤러리 스토리지·ItemsAdder 리소스팩)의 공통 베이스. 미설정 시 프로젝트 안 MC_SER/Server.
#   ⚠ 마크 서버 폴더를 다른 경로로 옮기면 이 한 줄만 새 "Server" 절대경로로 지정하면 위 참조가 전부 따라온다.
#     (더 세밀히는 SCHEMATICS_DIR / BLUEPRINT_GALLERY_DIR / ITEMSADDER_PACK_PATH 개별 env 가 각각 우선.)
#     단, DB 에 절대경로로 저장된 "기존 백업"은 서버 이동 시 옛 경로가 깨진다(신규 백업은 정상).
# MC_SERVER_DIR=D:\CraftopiaServer\Server
# [선택] 접근 차단 목록(blocklist) 식별자 해시용 키(HMAC-SHA256). 마크 UUID/Discord ID/이메일을
# 원문이 아닌 이 키로 만든 해시로만 저장합니다(재식별 방지). 미설정 시 위 MINECRAFT_API_SECRET 을 재사용하며,
# 운영에서 둘 다 기본값/짧으면 fail-closed 로 throw 합니다. 한번 정하면 바꾸지 마세요(바꾸면 기존 차단이 무효화됨).
# 생성 예시:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BLOCKLIST_HASH_SECRET=
# Dynmap 라이브 맵 URL. 같은 출처 리버스 프록시(next.config.ts 의 /dynmap-proxy → 로컬 Dynmap) 사용.
# 미설정 시 지도 버튼이 숨겨집니다. 서브도메인 대신 /dynmap-proxy 로 두면 터널/혼합콘텐츠 문제 없음.
NEXT_PUBLIC_MINECRAFT_MAP_URL=/dynmap-proxy
# Dynmap 내부 주소(프록시 대상). 미설정 시 http://localhost:8123.
# DYNMAP_INTERNAL_URL=http://localhost:8123
# 맵 이름(Dynmap mapname, 기본 flat). 필요 시 surface 등으로 변경.
# NEXT_PUBLIC_MINECRAFT_MAP_NAME=flat
# [선택] 월드 수명주기 스윕(30일 미사용→아카이브, 90일→영구삭제) 인증 시크릿.
# scripts/run-backup.ps1 이 이 값으로 /api/world/sweep 를 호출(8시간마다). 미설정 시 스윕 비활성.
# 생성 예시:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WORLD_SWEEP_SECRET=
# ── 전송 QoS(대역폭 공평 분배) — 정책 요약(src/lib/qosPolicy.ts) ─────────────────────────
#   방향별 "총 대역" 하나를 활성 사용자들이 역할 가중치(user 1 : creator+ 2)로 실시간 분배한다.
#   혼자면 총 대역 전체를 몰아 받고, n명이면 가중 1/n. 같은 유저의 동시 전송 여러 건은 유저 몫을 나눈다.
#
# [중요] 업로드 총 대역(동적 할당) — 초당 메가바이트(MB/s). 동시 업로더 전체의 합계 상한.
#   서버가 유저별 몫을 계산해 각 청크 응답(rateBps)으로 내려주고 브라우저 케이던스가 집행한다(폐루프).
#   혼자면 이 값 전체, 혼잡 시 가중 1/n(유저 몫 하한 0.5 · 동시 세션 상한 = 총량÷0.5, 유저당 3). 미설정=4, "0"=동적할당 off
#   (off 시 아래 NEXT_PUBLIC 기본레벨 고정 속도로 폴백), 하한 1.
WORLD_UPLOAD_TOTAL_MBPS=4
# [선택·기본 off] 서버측 업로드 수신 스로틀 — 초당 메가바이트(MB/s).
#   ⚠ 업로드(인바운드)는 cloudflared 가 회선에서 line-rate 로 당겨가 버퍼링하므로 서버측 스로틀로는 회선포화를
#     못 막는다(실측 확인). 그래서 기본 0(off). 업로드 회선 제한은 위 동적할당+아래 NEXT_PUBLIC(클라이언트)가 담당.
#   설정 시엔 디스크 쓰기 속도만 페이싱됨(방어적). "0"/미설정=off, 그 외 하한 1.
WORLD_UPLOAD_THROTTLE_MBPS=0
# [중요] 업로드 클라이언트 기본레벨 — 브라우저 송신 초기/폴백 속도(초당 메가바이트, MB/s).
#   업로드는 소스(브라우저)에서 페이싱해야 cloudflared 인바운드가 그 이하가 된다. 작은 청크(8MB)를 케이던스로
#   띄워 평균속도를 제한 → **Firefox/Safari·HTTP/1.1·비보안(plain-http LAN) 포함 전 브라우저에서 동작.**
#   동적 할당(위 TOTAL)이 켜져 있으면 첫 청크 이후 서버 몫(rateBps)이 이 값을 대체하고, 이 값은
#   첫 청크·구버전 클라의 안전 속도로만 쓰인다. NEXT_PUBLIC_ 이라 **빌드타임 인라인**(값 바꾸면 재빌드 필요).
#   미설정=1(빌더 기본레벨), "0"=무제한, 하한 0.5. creator 이상은 자동 2배(qosPolicy.qosWeight).
NEXT_PUBLIC_WORLD_UPLOAD_THROTTLE_MBPS=1
# [선택] 월드 다운로드(백업 zip 스트리밍) 아웃바운드 총 대역 — 초당 메가바이트(MB/s).
#   큰 백업 다운로드가 cloudflared 아웃바운드로 서버 회선을 포화시켜 MC 가 끊기는 것을 방지.
#   서버가 소스라 서버 WFQ 가 권위적으로 집행 — 혼자면 전체, 혼잡 시 유저 단위 가중 배분(creator 2배 지분).
#   OS QoS/터널 프로토콜(QUIC 등)에 무관하게 앱단에서 동작. 규칙은 위와 동일("0"=비활성, 하한 1). 기본 4 MB/s.
#   업링크가 다운링크보다 작은 회선이 많으니 필요하면 업로드보다 낮게 잡는다.
#   ※ 예상시간 표시는 기본레벨~총대역(1~4 MB/s) 범위 기준(src/lib/transferEta.ts).
WORLD_DOWNLOAD_THROTTLE_MBPS=4
# Discord 봇 HMAC 시크릿 (bot/.env 의 DISCORD_API_SECRET 과 일치시킬 것)
DISCORD_API_SECRET=

# ── Microsoft OAuth (마크 정품 인증, 자체 구현 — 무료) ──
# Azure(Entra) 포털 → 앱 등록 → "개인 Microsoft 계정" 허용, 플랫폼=Web, redirect URI 등록.
# client secret 생성 후 아래 채우기. MINECRAFT_OAUTH_REDIRECT_URI 는 Azure 등록값과 정확히 동일해야 함.
# ※ 앱은 Mojang allow list 승인 완료(2026-06-20) — login_with_xbox 정상 동작.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
MINECRAFT_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/minecraft/callback"

# ── Discord OAuth (웹 연동 센터 — 봇과 동일한 Discord 앱) ──
# 봇 Application 의 client_id 와 동일. Developer Portal → OAuth2 → Client Secret 발급 + Redirects 등록.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# ── Patreon OAuth (후원 연동 → 구독 자동 부여) ──
# Patreon 개발자 포털(https://www.patreon.com/portal/registration/register-clients)에서
# 크리에이터 계정으로 클라이언트를 등록하면 Client ID/Secret 이 발급됩니다.
# ⚠ 실제 redirect_uri 는 요청 호스트에서 파생됩니다(Discord·MS 와 동일한 OAuth 중앙화):
#    · 운영: https://auth.craftopia.work/api/auth/patreon/callback  ← Patreon 클라이언트 "Redirect URI" 에 이 값을 등록
#    · 로컬: http://localhost:3000/api/auth/patreon/callback         ← 로컬 테스트도 하려면 공백으로 구분해 함께 등록
#    (아래 PATREON_OAUTH_REDIRECT_URI 는 폴백용 — 라우트는 요청 호스트 기준으로 콜백을 만들므로 보통 미사용.)
# 활성 후원자(active_patron)로 인증되면 SHOP_SUBSCRIPTION_DAYS 기간만큼 구독이 보장됩니다(코인 차감 없음).
# 미설정(CLIENT_ID/SECRET) 시 Patreon 연결 버튼은 patreon_not_configured 로 안내되고 연동이 비활성화됩니다.
# 참고: 이 OAuth-연결 방식은 PATREON_CREATOR_ACCESS_TOKEN/REFRESH_TOKEN 을 쓰지 않습니다(웹훅 방식 확장 시 사용).
#
# 🔒 [필수·보안] PATREON_CAMPAIGN_ID — "우리 캠페인" 숫자 id. 활성 후원자 판정의 유일한 기준.
#   identity.memberships 는 사용자가 후원하는 '모든' 캠페인을 돌려주므로, 이 값과 일치하는 멤버십만 후원자로 인정한다.
#   ⚠ 미설정 시 fail-closed — 아무도 구독을 못 받는다(무관한 타 크리에이터 후원자에게 무료 구독이 새는 것을 원천 차단).
#   취득: 발급받은 Creator's Access Token 으로 아래 호출 → data[0].id 가 캠페인 id.
#     curl -H "Authorization: Bearer <CREATOR_ACCESS_TOKEN>" "https://www.patreon.com/api/oauth2/v2/campaigns"
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CAMPAIGN_ID=
PATREON_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/patreon/callback"

# ── 블루프린트 갤러리 → Discord 포럼 웹훅 ──
# 갤러리에 업로드 시 이 웹훅으로 포럼에 게시글(스레드)을 만든다. Discord 채널(포럼) → 연동 → 웹훅 URL.
DISCORD_GALLERY_WEBHOOK_URL=
# 봇 토큰(bot/.env 의 DISCORD_BOT_TOKEN 과 동일 값). 웹에서 갤러리 글을 삭제하면 Discord 포럼 게시글(스레드)까지
#  삭제하는 데 필요하다. ⚠ 웹훅만으로는 스레드를 못 지우므로(메시지만 지워져 빈 스레드가 남음) 봇 토큰이 필수.
#  봇은 대상 포럼 채널에 "스레드 관리(Manage Threads)" 권한이 있어야 한다. 미설정 시 삭제는 게시글을 남긴 채 넘어간다.
DISCORD_BOT_TOKEN=
# ── Discord 길드(서버) 가입 게이트 ──
# 설정하면(봇 토큰 + 이 길드 ID) Discord 연동을 **서버 가입자에게만** 허용한다(비멤버 연동 거부, 조회장애=fail-closed).
#  이탈 시 봇이 /api/discord/membership 로 통지 → 건축권한(builder)·웹 대시보드 회수. bot/.env 의 DISCORD_GUILD_ID 와 동일 값.
#  비어 있으면 게이트 비활성(연동은 기존대로 동작). ⚠ 도입 시 배포 전 `npx tsx scripts/backfill-discord-in-guild.ts` 1회 실행.
DISCORD_GUILD_ID=
# 미가입자가 연동을 시도하면 안내 메시지와 함께 이 초대 링크로 "Discord 서버 참여하기" 버튼이 노출된다.
#  미설정 시 코드 내 기본 초대 링크로 폴백. 초대 링크가 만료/변경되면 이 값만 갱신하면 된다.
DISCORD_INVITE_URL=https://discord.gg/xbA5Y5QWf5

# 위키(가이드·문서) 링크 — 건축 대시보드·블루프린트 갤러리 상단의 "위키" 버튼이 이 주소로 연결된다.
# NEXT_PUBLIC_ 접두사(클라이언트 노출 필수). 미설정 시 코드 기본값(https://wiki.craftopia.work)으로 폴백.
NEXT_PUBLIC_WIKI_URL=https://wiki.craftopia.work
# 전시관(showcase) 포럼 채널 id 목록(콤마 구분). 이 포럼 게시물의 👍 반응이 작성자 코인 보상 + 주간 최다반응 보상 대상이 된다.
#  비어 있으면 전시관 포럼 반응 보상은 전부 비활성(블루프린트 갤러리 반응은 이 값과 무관하게 동작).
SHOWCASE_FORUM_CHANNEL_IDS=

# ── DB 백업 스크립트(scripts/backup-db.mjs) 용 (선택) ──────────────
# BC_DB_PATH=./dev.db
# BC_BACKUP_DIR=./backups
# BC_BACKUP_LOG=./backups/backup.log
# BC_BACKUP_RETENTION=14
# BC_BROTLI_QUALITY=11

# ── off-site 백업: Cloudflare R2 (scripts/upload-r2.mjs) ──────────
# 아래 R2_* 4개가 모두 채워져야 백업본이 R2로 업로드됩니다(비우면 로컬 백업만, 자동 skip).
# 발급: Cloudflare 대시보드 → R2 → 버킷 생성(비공개) → "Manage R2 API Tokens"(Object Read & Write)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=blockcanvas-backups
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   # 선택(미설정 시 ACCOUNT_ID로 자동 구성)
# 용량 80% 도달 알림 채널(선택). Discord 채널 → 연동 → 웹훅 URL.
# DISCORD_WEBHOOK_URL=
# R2_USAGE_ALERT_BYTES=8589934592        # 선택: 알림 임계(기본 8GiB = 무료 10GB의 80%)
# R2_UPLOAD_MIN_INTERVAL_HOURS=20        # 선택: off-site 업로드 최소 간격(기본 ~1회/일)
