# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 단, 환경변수 템플릿은 커밋 대상에 포함한다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal
*.db-wal
*.db-shm
/public/uploads/
*.mp4
*.zip
*.rar
*.tar.gz

# Cloudflare tunnel (local infra + credentials — never commit)
/CloudflaredTunnel/

# throwaway dev scripts
/scratch/

# DB backups (compressed .db.br snapshots + log) — never commit
/backups/

# Minecraft server (separate project, ~800MB world/jar data — never commit)
/MC_SER/

# 외부 참고용 UI 라이브러리 사본 (자체 .git 보유 — 추적/린트 제외)
/temp_animate_ui/
