# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 단, 환경변수 템플릿은 커밋 대상에 포함한다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal
*.db-wal
*.db-shm
/dev.db.pre-mc-*.bak
# 타임스탬프 DB 백업(유저 데이터 스냅샷) — never commit
/dev.db.bak
/dev.db.bak-*
/public/uploads/
*.mp4
*.zip
*.rar
*.tar.gz

# Cloudflare tunnel (local infra + credentials — never commit)
/CloudflaredTunnel/

# throwaway dev scripts
/scratch/

# DB backups (compressed .db.br snapshots + log) — never commit
/backups/

# 앱 로그 백업(PII 포함 가능) — never commit
/log-backups/

# Claude Code 로컬/개인 설정 — never commit
/.claude/settings.local.json

# Minecraft server (separate project, ~800MB world/jar data — never commit)
/MC_SER/

# Discord 봇 (독립 패키지) — 의존성/시크릿 제외
/bot/node_modules/
/bot/.env

# 외부 참고용 UI 라이브러리 사본 (자체 .git 보유 — 추적/린트 제외)
/temp_animate_ui/

# 외부 변환 도구 SchemConvert (GPL-3.0) — 3rd party 바이너리는 커밋 안 함(별도 다운로드/배치)
/tools/*.jar
