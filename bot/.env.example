# ── BlockCanvas Discord 봇 설정 ──────────────────────────────
# 이 파일을 bot/.env 로 복사한 뒤 값을 채우세요.

# 봇 토큰 (Discord Developer Portal → Application → Bot → Token)
DISCORD_BOT_TOKEN=

# 애플리케이션(클라이언트) ID (Developer Portal → General Information → Application ID)
DISCORD_CLIENT_ID=

# 선택: 특정 길드(서버)에만 즉시 명령 등록(개발용). 비우면 글로벌 등록(반영 최대 1시간).
DISCORD_GUILD_ID=

# BlockCanvas 웹 API 베이스 URL (운영: https://craftopia.work)
WEB_API_URL=http://localhost:3000

# 웹의 .env 의 DISCORD_API_SECRET 과 반드시 동일해야 함 (HMAC 서명)
DISCORD_API_SECRET=
