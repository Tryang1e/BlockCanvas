generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id              String   @id @default(uuid())
  role            String   @default("user")
  creator_name    String   @unique
  display_name    String?
  email           String?  @unique // 한 이메일 = 한 계정(중복 가입/동시 인증 TOCTOU 방지). null 다수는 허용(소셜 전용 계정).
  password        String?
  token_version   Int      @default(0) // 세션 무효화용. 비번 변경/재설정 시 +1 → 기존 세션 토큰(구버전) 거부.
  avatar_url      String?
  commission_open Boolean  @default(false)
  discord_id      String?
  created_at      DateTime @default(now())

  // --- 운영/제재 (어드민 처벌 체계) — 웹 DB가 원장, 마크/디스코드는 best-effort 전파(lib/moderation) ---
  status            String             @default("active") // active | suspended(이용정지·DB 보관) | banned(항소 후 영구차단=삭제 대상)
  suspended_until   DateTime? // 정지 만료 시각. status='suspended' 인데 null = 무기한 정지.
  muted_until       DateTime? // 뮤트 만료 시각. null = 뮤트 아님.
  moderation_reason String? // 최신 처벌 사유(로그인 차단/상태 표시용)
  moderation_logs   ModerationAction[] // 이 유저에게 적용된 처벌 이력
  notifications     Notification[] // 개인 알림함(공지·DM·처벌·코인 안내)

  portfolios              Portfolio?
  sections                PortfolioSection[]
  projects                Project[]
  project_likes           ProjectLike[] // 내가 누른 프로젝트 좋아요
  purchases               Purchase[] // 상점 구매(영구 해금 등)
  active_title            String? // 현재 적용 중인 칭호 키(상점 구매분 중 선택)
  messages                ContactMessage[]
  wip_logs                WipLog[]
  two_factor_secret       String?
  two_factor_enabled      Boolean            @default(false)
  privacy_consented       Boolean            @default(false)
  privacy_consented_at    DateTime?
  privacy_consent_version String? // 동의한 개인정보 처리방침 버전(예: v2). 현재 버전과 다르면 재동의 필요. null=레거시 동의.

  // --- Minecraft 연동 (MC_SER) ---
  minecraft_uuid            String?             @unique
  minecraft_username        String?
  last_seen_at              DateTime? // 마지막 MC 접속(역동기화 role-sync). 스키매틱 90일 미접속 정리에 사용.
  world_quota_state         String              @default("ok") // 월드 클라우드 쿼터: ok | warned(90%+) | locked(초과→전 월드 비활성, 다운로드/삭제만)
  subscription_until        DateTime? // BLOCKCANVAS 구독 만료 시각. null/과거=미구독. 코인 구매/Patreon 모두 이 필드를 max(now,until)+기간 으로 연장(소스 무관 누적).
  role_granted_by_sub       Boolean             @default(false) // role 이 구독 혜택('포트폴리오 사이트')으로 user→creator 승격된 것인지. 만료 스윕이 이 유저만 user 로 강등(게이트만 닫힘=데이터 보존). 원래 크리에이터(false)는 불변.
  block_invites             Boolean             @default(false) // 본인이 켜면 누구도 이 유저를 플롯/월드에 초대(trust)할 수 없음(웹+인게임 enforcement)
  // --- 인게임 활동 보상(플러그인 보고 → 웹 지급, Phase2) ---
  block_net_total           Int                 @default(0) // 누적 순설치 블록(설치−파괴). 플러그인이 델타 보고 → 웹 누적. 마일스톤 근거.
  block_milestones_paid     Int                 @default(0) // 지급 완료한 블록 마일스톤 횟수(floor(block_net_total/step))
  playtime_milestones_paid  Int                 @default(0) // 지급 완료한 누적접속 마일스톤 횟수(floor(playtime_min/step)) — playtime 은 단조증가 바닐라 통계
  plot_slot_bonus           Int                 @default(0) // 상점 '플롯 확장 구매권' 누적 구매 수 = 최대 플롯 claim 한도 개인 보너스(+N). 다음 가격 = base×2^plot_slot_bonus. 마크 서버에 claim 요청 시 함께 전달돼 한도에 가산.
  signup_bonus_at           DateTime? // 3종 인증(디스코드+마크+웹가입) 최초 완료 시 지급하는 가입 보너스 코인 지급 시각. null=미지급. 재지급 방지(멱등).
  minecraft_plots           MinecraftPlot[]
  minecraft_worlds          MinecraftWorld[]
  pending_transfers         PendingTransfer[]
  schematic_shares_owned    SchematicShare[]    @relation("SchematicShareOwner") // 내가 남에게 공유한 폴더
  schematic_shares_received SchematicShare[]    @relation("SchematicShareGrantee") // 나에게 공유된 폴더
  blueprint_posts           BlueprintPost[] // 내가 갤러리에 공유한 블루프린트 게시물
  blueprint_reports         BlueprintReport[]   @relation("BlueprintReportReporter") // 내가 신고한 게시물
  blueprint_downloads       BlueprintDownload[] // 내가 다운로드한 갤러리 게시물(고유 카운트)
  blueprint_bookmarks       BlueprintBookmark[] // 내가 북마크한 갤러리 게시물
  blueprint_purchases       BlueprintPurchase[] // 내가 구매한 유료 블루프린트 게시물
  coin_awards               CoinAward[] // 코인 획득 원장(분석용)

  // --- Discord 연동 (OAuth — discord_id/username 만 Profile 에 보관) ---
  discord_username String?
  // 현재 Discord 길드(서버) 멤버 여부. 연동 시 봇 토큰으로 확인해 true 로만 채워지고, 이탈하면 false 로 내려간다.
  // 3종 인증 게이트(hasFullVerification)의 필수 조건 — false 면 인게임 건축권한(builder)·웹 건축 대시보드가 회수된다.
  // ⚠ 이탈로 discord_id 를 지우지 않는다(로그인 수단·재가입 자동복구 보존; 개인정보 파기는 계정 탈퇴 경로에서만).
  discord_in_guild Boolean @default(false)

  // --- Patreon 연동 (OAuth — 후원자 식별자만 보관, 이메일/토큰 미저장) ---
  // 활성 후원자면 subscription_until 을 "적어도 지금+기간" 으로 끌어올린다(멱등, lib/subscription.subscriptionUntilAtLeast).
  // 재연결을 반복해도 기간이 누적되지 않는다(악용 방지). 코인 구매분은 그 위에 별도 가산.
  patreon_user_id   String? @unique // Patreon user id(계정 1:1 매핑 + 중복 연결 차단). null=미연동.
  patreon_full_name String? // Patreon 표시 이름(연동 카드 표시용). 이메일은 저장하지 않는다.
}

model Portfolio {
  creator_id      String  @id
  headline        String?
  about_text      String?
  banner_url      String?
  contact_email   String?
  footer_title    String?
  footer_subtitle String?
  patreon_url     String?
  twitter_url     String?
  youtube_url     String?
  instagram_url   String?
  sns_settings    String? // Store JSON string or use separate fields
  theme_bg_color  String? @default("#222222")
  theme_bg_effect String? @default("none")
  is_published    Boolean @default(true)
  creator         Profile @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([is_published]) // explore: 공개 포트폴리오 필터
}

model PortfolioSection {
  id             String    @id @default(uuid())
  creator_id     String
  name           String
  sort_order     Int       @default(0)
  created_at     DateTime  @default(now())
  section_type   String    @default("image_grid")
  content        String?
  show_title     Boolean   @default(true)
  is_visible     Boolean   @default(true)
  animation_type String    @default("fade-in")
  creator        Profile   @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  projects       Project[]

  @@index([creator_id]) // 크리에이터별 섹션 조회
}

model Project {
  id            String            @id @default(uuid())
  creator_id    String
  title         String
  description   String?
  thumbnail_url String?
  content       String? // JSON string
  category_id   String?
  created_at    DateTime          @default(now())
  section_id    String?
  sort_order    Int               @default(0)
  youtube_url   String?
  is_published  Boolean           @default(false)
  view_count    Int               @default(0)
  like_count    Int               @default(0) // 좋아요 수(비정규화, 표시·정렬용. 원장=ProjectLike)
  coin_rewarded Boolean           @default(false) // 게시 적립(작성자 코인) 지급 완료 여부 — 재발행 어뷰징 방지(1회만)
  creator       Profile           @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  section       PortfolioSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)
  widgets       ProjectWidget[]
  wip_logs      WipLog[]
  likes         ProjectLike[]

  @@index([creator_id]) // 크리에이터별 프로젝트 조회
  @@index([section_id]) // 섹션별 프로젝트 조회
  @@index([is_published, created_at]) // explore: 공개 프로젝트 최신순
}

// 프로젝트(전시 게시글) 좋아요 — 1인 1좋아요. 신규 좋아요 시 작성자에게 코인 적립(awardCoins).
model ProjectLike {
  id         String   @id @default(uuid())
  project_id String
  profile_id String
  created_at DateTime @default(now())
  project    Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  profile    Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([project_id, profile_id]) // 같은 글에 중복 좋아요 방지
  @@index([profile_id]) // 내가 누른 좋아요 조회
}

// 상점 구매 기록 — 영구 해금(칭호·치장 등). 코인 차감은 인게임 CMI(서버)에서, 여기엔 소유 기록만.
model Purchase {
  id         String   @id @default(uuid())
  profile_id String
  item_key   String // 카탈로그 키(예: title_master)
  kind       String // 품목 종류(title | cosmetic | …)
  price      Int // 구매 당시 가격(코인)
  created_at DateTime @default(now())
  profile    Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, item_key]) // 같은 항목 중복 구매 방지(영구 해금)
  @@index([profile_id])
}

model ProjectWidget {
  id         String  @id @default(uuid())
  project_id String
  type       String
  content    String? // JSON string
  sort_order Int     @default(0)
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id]) // 프로젝트별 위젯 조회
}

model SiteSetting {
  key        String   @id
  value      String // JSON string
  updated_at DateTime @updatedAt
}

model Category {
  id         String   @id @default(uuid())
  name       String   @unique
  slug       String   @unique
  sort_order Int      @default(0)
  created_at DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  admin_name String
  action     String
  target_id  String?
  details    String?
  created_at DateTime @default(now())

  @@index([created_at]) // 감사 로그 최신순 조회
}

model CreatorLog {
  id           String   @id @default(uuid())
  creator_name String
  action       String
  target_id    String?
  details      String?
  created_at   DateTime @default(now())

  @@index([creator_name, created_at]) // 크리에이터별 활동 로그 최신순
}

// 처벌 이력 원장 — 한 유저에게 적용/해제된 모든 제재 기록(누가·언제·무엇을). Profile 상태필드는 비정규화 캐시.
model ModerationAction {
  id             String    @id @default(uuid())
  target_id      String // 처벌 대상 Profile.id
  moderator_name String // 처벌을 가한 관리자/스태프(creator_name 또는 'admin')
  type           String // mute | suspend | ban | warn | lift_mute | lift_suspend | unban
  severity       String? // low | medium | high | custom (처벌 적용 시. 해제 액션은 null)
  reason         String?
  mute_until     DateTime? // 이 액션이 설정한 뮤트 만료(없으면 null)
  suspend_until  DateTime? // 이 액션이 설정한 정지 만료(무기한이면 null)
  permanent      Boolean   @default(false) // ban(영구차단) 여부
  created_at     DateTime  @default(now())
  target         Profile   @relation(fields: [target_id], references: [id], onDelete: Cascade)

  @@index([target_id, created_at]) // 대상별 처벌 이력 최신순
}

// 개인 알림함 — 공지(전체 fan-out)·DM·처벌 안내·코인 지급 안내. 유저 대시보드 메시지함에 노출.
model Notification {
  id           String   @id @default(uuid())
  recipient_id String // 수신자 Profile.id
  sender_name  String // 발신 관리자/스태프 또는 'system'
  category     String   @default("notice") // dm | notice | moderation | coin | system
  title        String
  body         String
  meta         String? // JSON(예: { coin: 100 }) — 카테고리별 부가정보
  is_read      Boolean  @default(false)
  created_at   DateTime @default(now())
  recipient    Profile  @relation(fields: [recipient_id], references: [id], onDelete: Cascade)

  @@index([recipient_id, is_read, created_at]) // 수신자별 미읽음/최신순
}

model ContactMessage {
  id          String    @id @default(uuid())
  creator_id  String
  name        String
  email       String
  message     String
  is_read     Boolean   @default(false)
  reply       String?
  replied_at  DateTime?
  reply_read  Boolean   @default(false)
  sender_name String?
  created_at  DateTime  @default(now())
  creator     Profile   @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([creator_id, created_at]) // 크리에이터별 메시지함 최신순
  @@index([email, created_at]) // 이메일 기준 레이트리밋 조회
}

model WipLog {
  id          String   @id @default(uuid())
  creator_id  String
  title       String
  description String?
  media_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  project_id  String?
  profile     Profile  @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([creator_id])
  @@index([project_id]) // 프로젝트별 WIP 로그 조회
  @@index([created_at]) // explore: 전체 WIP 로그 최신순
}

// ============================================================
//  Minecraft 연동 (MC_SER) — 웹↔마인크래프트 서버 영토 연동
// ============================================================

// 인게임 플롯의 웹측 캐시. syncMyPlots() 가 Spigot /api/plot/list 응답으로 upsert 한다.
// NOTE: id 는 "<world>:<plotId>" 복합 문자열 PK (예: "plot_300:1;2"). 같은 plotId 가 여러 플롯월드에
//       존재할 수 있어 world 로 네임스페이스한다(web: plotCacheId(world, plotId)). plot_id 는 표시·플러그인 호출용 바레 ID.
model MinecraftPlot {
  id              String   @id // "<world>:<plotId>" — 캐시 행 키(월드 간 충돌 방지)
  plot_id         String   @default("") // PlotSquared 바레 플롯 ID "x;z" (표시·플러그인 호출용)
  owner_id        String
  world           String   @default("world")
  alias           String?
  members         String? // JSON 배열(임시 add 권한 UUID들)
  trusted_players String? // JSON 배열(영구 trust 권한 UUID들)
  center_x        Int? // 플롯 중심 월드 X (Dynmap 임베드용)
  center_z        Int? // 플롯 중심 월드 Z (Dynmap 임베드용)
  auction_price   Float? // 경매 매물 가격(코인). null = 경매중 아님 (인게임에서 역동기화)
  updated_at      DateTime @updatedAt
  owner           Profile  @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id]) // 소유자별 플롯 조회
}

// 웹에서 신청한 소유권 양도 요청 기록. 실제 권한 변경은 양수인이 /플롯 수락(인게임) 또는 웹 대시보드에서 수락할 때 완료된다(2FA).
// 수락/거절 결과는 플러그인이 역방향 webhook(/api/minecraft/sync)으로 push 해 status 가 갱신된다.
model PendingTransfer {
  id          String   @id @default(uuid())
  plot_id     String
  world       String   @default("world") // 플롯이 속한 플롯월드(같은 plot_id 충돌 방지 — 마크 서버 재조회용)
  from_id     String // 양도를 신청한 프로필
  target_name String // 인게임 대상 닉네임
  status      String   @default("pending") // pending | accepted | rejected | expired
  created_at  DateTime @default(now())
  from        Profile  @relation(fields: [from_id], references: [id], onDelete: Cascade)

  @@index([from_id, status]) // 내 양도 신청 현황 조회
}

// 이메일/비밀번호 회원가입 대기열. 인증 메일의 토큰 링크를 클릭하면 Profile(role=user) 로 승격된다.
// 인증 전에는 Profile 을 만들지 않아(핸들 선점·미인증 계정 방지) 토큰 소비 시점에 생성한다.
model EmailVerification {
  id            String   @id @default(uuid())
  email         String   @unique // 동일 이메일 재가입 시 upsert 로 토큰 갱신
  password_hash String
  display_name  String? // 가입 시 입력한 닉네임. 인증 완료 시 Profile.display_name + 핸들 기준으로 사용.
  profile_id    String? // set 이면 신규 가입이 아니라 기존 계정에 이메일/비번 추가(Discord-only 가입자용 3종 충족)
  token         String   @unique
  created_at    DateTime @default(now())
}

// 비밀번호 재설정(비밀번호 찾기) 1회용 토큰. 메일 링크의 토큰으로 새 비밀번호를 설정하면 소비된다.
// 계정 존재 여부 노출 방지를 위해 요청 액션은 항상 동일한 성공 응답을 반환한다(여기 레코드 유무는 비공개).
model PasswordReset {
  id         String   @id @default(uuid())
  email      String   @unique // 동일 이메일 재요청 시 upsert 로 토큰 갱신
  token      String   @unique
  created_at DateTime @default(now())
}

// 인게임 개인 월드(클라우드). Multiverse-Core 로 호스팅. MyIdea §2(클라우드 제공) — Builder's Refuge 스타일.
// 웹은 메타데이터/권한을 관리하고, 실제 생성·백업 등은 BlockCanvasLink 플러그인이 수행(추후 연동).
model MinecraftWorld {
  id                  String    @id @default(uuid())
  owner_id            String
  import_key          String?   @unique // 청크 업로드 멱등 키(= uploadId). 재시도/응답유실 시 같은 키면 재삽입 대신 기존 월드 반환 → 중복 방지.
  name                String // 표시 이름(사용자가 정한 월드 이름)
  world_key           String? // {닉네임}_{월드이름} 의 sha256 해시(hex). mv_world(서버 폴더명)의 원본 — 폴더명에 닉/이름 노출 방지.
  source              String    @default("basic") // basic(기본 생성: 평지/야생) | import(.zip 업로드)
  mv_world            String? // 서버상의 월드 폴더명(= w_<world_key 앞부분>). 프로비저닝 완료 후 채워짐.
  generator           String    @default("flat") // flat | wild | (커스텀 generator 문자열)
  icon                String? // 월드 목록 아이콘 프리셋 키 (worldIcons.ts, 관리자 등록 블록 이미지)
  version             String? // MC 버전 (예: "1.21.1")
  size_bytes          BigInt    @default(0) // 디스크 사용량(바이트). 쿼터 계산용. 액션 경계에서 Number 로 변환.
  border              Int       @default(3000) // 월드 보더 (청크 과확장 방지, MyIdea §2-6)
  flags               String? // JSON: 게임룰/플래그 (mobSpawning, weather, time, blockPhysics, fluidSpread …)
  trusted_players     String? // JSON 배열 [{uuid,name}] — 초대 멤버 (MyIdea §2-5/2-10)
  status              String    @default("provisioning") // provisioning | active | archived(아카이브: 서버에서 내려감, Restore 가능)
  last_saved          DateTime?
  last_active_at      DateTime? // 마지막 사용(접속/열람) 시각. +30일 미사용=아카이브, +90일=영구삭제 (수명주기).
  last_backup_at      DateTime? // 백업 24h 1회 제한 (MyIdea §2-5)
  backup_path         String? // 최신 백업/아카이브 zip 절대경로(복구용 = backups[0]).
  backups             String? // JSON 배열 [{path,ts,bytes}] 최신순, 최대 5개(초과 시 가장 오래된 것 삭제). 날짜별 다운로드용.
  archived_at         DateTime? // 아카이브된 시각
  pending_transfer_to String? // 양도 대기: 받는 사람 Profile.id (수락 시 owner_id 로 이전). null=대기 없음.
  pending_transfer_at DateTime? // 양도 요청 시각
  explore_shared      Boolean   @default(false) // 소유자가 "탐방 공유" 켬 — /탐방 목록에 노출(유저당 최대 9개)
  explore_suspended   Boolean   @default(false) // 관리자/스태프가 이 월드의 탐방 공유를 정지(목록에서 숨김, 소유자 토글 무관)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  owner               Profile   @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id, status]) // 소유자별 월드 조회
  @@index([status, last_active_at]) // 수명주기 스윕(만료/삭제 대상 탐색)
  @@index([explore_shared]) // 탐방 목록(공유된 월드) 조회
}

// 스키매틱 폴더 공유 — owner 가 grantee 에게 자기 개인 스키매틱 폴더(= owner.minecraft_uuid)를 공유.
// 권한 레벨(월드 멤버 권한과 동일한 "권한 형식" 철학): view(보기/다운로드) | edit(+업로드/삭제).
// 인게임 //schem load 는 FAWE 전체공개라 세분화 불가 → 웹 공유만 권한 세분화(다운로드 후 본인 폴더 업로드로 인게임 사용).
model SchematicShare {
  id         String   @id @default(uuid())
  owner_id   String // 폴더 소유자 Profile.id (실제 폴더 = owner.minecraft_uuid)
  grantee_id String // 공유받는 사람 Profile.id (웹 로그인해 "공유받은 스키매틱"에서 접근)
  perm       String   @default("view") // view(보기/다운로드) | edit(+업로드/삭제)
  created_at DateTime @default(now())
  owner      Profile  @relation("SchematicShareOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  grantee    Profile  @relation("SchematicShareGrantee", fields: [grantee_id], references: [id], onDelete: Cascade)

  @@unique([owner_id, grantee_id]) // 한 사람당 한 폴더에 권한 하나
  @@index([grantee_id]) // 나에게 공유된 폴더 목록 조회
}

// ============================================================
//  블루프린트 갤러리 (.bp/.schem 공유) — axiomassets 스타일 자체 갤러리.
//  인증 완료 유저가 공유 → Discord 웹훅 게시 + 코인 적립, 다운로드(파일/내 클라우드 추가), 이용약관 위반 신고.
//  파일은 갤러리 전용 스토리지에 스냅샷(불변) — 개인 스키매틱 클라우드(FAWE 폴더)와 분리.
// ============================================================

// 갤러리 공유 게시물 — .bp(Axiom)/.schem 한 건. 표지(.bp=내장 썸네일 자동추출, .schem=업로드)는 public 으로 서빙.
model BlueprintPost {
  id                       String              @id @default(uuid())
  author_id                String
  title                    String
  description              String?
  ext                      String // ".bp" | ".schem" — 저장된 원본 확장자
  file_path                String // 갤러리 스토리지 상대경로(<postId>/blueprint.<ext>). 개인 클라우드와 무관(불변 스냅샷).
  file_bytes               Int                 @default(0)
  cover_path               String? // 표지 public 경로(/uploads/blueprints/<id>.webp). .bp=내장 썸네일 추출, .schem=업로드.
  tags                     String? // JSON 배열(검색/필터용 태그)
  price                    Int                 @default(0) // 판매가(코인). 0=무료(무료 다운로드+작성자 마일스톤 보상). >0=유료(구매 후 다운로드, 판매10%+구매10% 수수료 소각). ⚠게시 후 가격 변경 미지원 — 변경 기능을 추가하려면 milestones_paid=floor(download_count/step)로 소진해 마일스톤 이중지급을 막을 것.
  status                   String              @default("published") // published | hidden(신고 임계 자동숨김) | removed(스태프 제거)
  view_count               Int                 @default(0)
  download_count           Int                 @default(0) // 무료글=고유 다운로더 수(BlueprintDownload 원장 기준). 유료글=판매 건수(구매 시 +1, BlueprintDownload 미생성). 인기순 정렬 공용.
  bookmark_count           Int                 @default(0) // 북마크 수(BlueprintBookmark 원장 기준, 비정규화 표시용)
  reaction_count           Int                 @default(0) // 👍 고유 반응자 수(웹 회원·작성자 제외, BlueprintReaction 원장 기준)
  report_count             Int                 @default(0) // 미해결 신고 수(자동숨김 트리거)
  publish_coin_rewarded    Boolean             @default(false) // (사용 안 함) 게시 적립 폐지됨 — 파밍 방지 위해 보상은 다운로드/반응 마일스톤만
  milestones_paid          Int                 @default(0) // (기본 트랙) 지급 완료한 다운로드 마일스톤 횟수(floor(고유다운로드/step))
  reaction_milestones_paid Int                 @default(0) // (기본 트랙) 지급 완료한 반응(👍) 마일스톤 횟수(floor(고유반응/step))
  download_bonus_paid      Int                 @default(0) // (보너스 트랙) 지급 완료한 다운로드 보너스 마일스톤 횟수(floor(고유다운로드/bonusStep))
  reaction_bonus_paid      Int                 @default(0) // (보너스 트랙) 지급 완료한 반응 보너스 마일스톤 횟수(floor(고유반응/bonusStep))
  removal_reason           String? // 스태프 제거/자동숨김 사유(작성자 안내·감사용)
  discord_message_id       String? // 웹훅으로 게시된 Discord 메시지 id(있으면)
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt
  author                   Profile             @relation(fields: [author_id], references: [id], onDelete: Cascade)
  reports                  BlueprintReport[]
  downloads                BlueprintDownload[]
  bookmarks                BlueprintBookmark[]
  reactions                BlueprintReaction[]
  purchases                BlueprintPurchase[]

  @@index([status, created_at]) // 갤러리 최신순
  @@index([status, download_count]) // 인기순
  @@index([author_id]) // 내 게시물
}

// 게시물 신고 — 이용약관 위반 건축물 신고(1인 1게시물 1신고). 스태프가 검토 후 제거/기각.
model BlueprintReport {
  id          String        @id @default(uuid())
  post_id     String
  reporter_id String
  reason      String // stolen(도용) | inappropriate(부적절) | spam(스팸) | broken(손상/오류) | other(기타)
  detail      String?
  status      String        @default("pending") // pending | resolved_removed(제거) | resolved_dismissed(기각)
  resolved_by String? // 처리 스태프 creator_name
  resolved_at DateTime?
  created_at  DateTime      @default(now())
  post        BlueprintPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  reporter    Profile       @relation("BlueprintReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@unique([post_id, reporter_id]) // 1인 1게시물 1신고(중복 신고/표 조작 방지)
  @@index([status, created_at]) // 관리자 신고함 최신순
}

// 고유 다운로드 원장 — (게시물, 유저) 1행. 고유 다운로더 카운트 + 다운로드 마일스톤 보너스 어뷰징 방지(재다운/본인다운 무보상).
model BlueprintDownload {
  id         String        @id @default(uuid())
  post_id    String
  profile_id String
  created_at DateTime      @default(now())
  post       BlueprintPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  profile    Profile       @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([post_id, profile_id]) // 고유 다운로더 1회만 카운트
  @@index([profile_id])
}

// 북마크(즐겨찾기) — (게시물, 유저) 1행. 내가 저장한 블루프린트를 '북마크' 탭에서 모아 본다.
model BlueprintBookmark {
  id         String        @id @default(uuid())
  post_id    String
  profile_id String
  created_at DateTime      @default(now())
  post       BlueprintPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  profile    Profile       @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([post_id, profile_id]) // 1인 1게시물 1북마크
  @@index([profile_id, created_at]) // 내 북마크 최신순
}

// 디스코드 👍 반응 원장 — (게시물, 디스코드 유저 id) 1행. 고유 반응자 카운트 + 반응 마일스톤 파밍 방지.
// 반응자는 웹 회원(Profile.discord_id 매칭)이어야 하고 작성자 본인은 제외(라우트에서 검증). Discord 는 유저당 같은
// 이모지 1회만 허용 + 이 원장으로 뗐다 재-반응해도 재지급 없음. discord_user_id 는 Profile FK 아님(디스코드 id 문자열).
model BlueprintReaction {
  id              String        @id @default(uuid())
  post_id         String
  discord_user_id String
  created_at      DateTime      @default(now())
  post            BlueprintPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([post_id, discord_user_id]) // 고유 반응자 1회만 카운트
  @@index([post_id])
}

// 유료 블루프린트 구매 원장 — (게시물, 구매자) 1행. 유료글은 구매해야 다운로드/클라우드 추가 가능(구매 후 재다운로드 무료).
// 구매자는 가격+구매수수료(기본 10%)를 지불, 판매자는 가격−판매수수료(기본 10%)를 받고, 수수료 합(20%)은 소각(경제에서 제거)돼
// 서버 인플레이션·쌀먹(현금화)을 억제한다. price/fee/seller_amount 는 구매 시점 스냅샷(이후 판매가가 바뀌어도 불변).
model BlueprintPurchase {
  id            String        @id @default(uuid())
  post_id       String
  buyer_id      String
  price         Int // 구매 시점 판매가(스냅샷)
  fee           Int           @default(0) // 소각된 수수료 합(구매수수료 + 판매수수료)
  seller_amount Int           @default(0) // 판매자가 받은 금액(가격 − 판매수수료)
  created_at    DateTime      @default(now())
  post          BlueprintPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  buyer         Profile       @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  @@unique([post_id, buyer_id]) // 1인 1게시물 1구매(재구매 방지 + 구매 여부 판정)
  @@index([buyer_id, created_at]) // 내 구매목록 최신순
  @@index([post_id])
}

// 일반 포럼 게시물(예: 전시관-showcase)의 👍 반응 보상 — allowlist 채널 + 인증 작성자 글이면 작성자에게 코인.
// 블루프린트 갤러리(BlueprintPost)와 별개 트랙: 여긴 웹 업로드가 아니라 디스코드 포럼에 직접 올린 글(파일/표지 없음).
// message_id = 포럼 게시물(스레드 시작 메시지) id. 반응 설정(step/coin)은 갤러리와 동일 config 공유.
model ForumReactionPost {
  message_id      String          @id // Discord 포럼 게시물(스레드 시작 메시지) id
  channel_id      String // 부모 포럼 채널 id(allowlist 판정용)
  author_id       String // 인증 작성자 Profile.id
  reaction_count  Int             @default(0)
  milestones_paid Int             @default(0) // (기본 트랙) floor(반응/step)
  bonus_paid      Int             @default(0) // (보너스 트랙) floor(반응/bonusStep)
  created_at      DateTime        @default(now())
  reactions       ForumReaction[]

  @@index([author_id])
}

model ForumReaction {
  id              String            @id @default(uuid())
  message_id      String
  discord_user_id String
  created_at      DateTime          @default(now())
  post            ForumReactionPost @relation(fields: [message_id], references: [message_id], onDelete: Cascade)

  @@unique([message_id, discord_user_id]) // 고유 반응자 1회만
  @@index([message_id])
}

// 전시관(showcase) 포럼 주간 최다 반응 게시물 보상 원장 — ISO 주(월~일)당 1행(week_key unique 로 멱등).
// 매주 스윕(/api/world/sweep)이 "직전 완료된 주"에 새로 받은 👍 반응 수가 가장 많은 게시물을 뽑아
// 작성자에게 1회 보상한다. 반응 마일스톤(ForumReactionPost)과 별개 트랙 — 여긴 주간 1등 보너스만 기록.
//  - 멱등: week_key 를 먼저 claim(create)한 뒤 지급 → 스윕이 8시간마다 여러 번 돌아도 주당 1회만 지급.
//  - author_id 는 FK 아님(Profile 삭제돼도 수상 이력 보존) — CoinAward 와 동일 철학.
//  - 그 주 반응이 0건이면 message_id/author_id=null, coin=0 으로 "처리됨"만 표시(재계산 방지).
model ForumWeeklyAward {
  id             String   @id @default(uuid())
  week_key       String   @unique // ISO 주 키 "YYYY-Www" (예: "2026-W27")
  message_id     String? // 수상 게시물(스레드 시작 메시지) id — 그 주 반응 0건이면 null
  author_id      String? // 수상 작성자 Profile.id
  reaction_count Int      @default(0) // 그 주에 새로 받은 반응 수(수상 근거)
  coin           Int      @default(0) // 실제 지급 코인(일일 상한 반영 후, 0=미지급)
  created_at     DateTime @default(now())

  @@index([created_at])
}

// 코인 경제 원장 — 경제순환 분석용(유입/유출/순증감·소스별·유저별). 모든 코인 이동을 여기 1행으로 기록.
// Profile 삭제돼도 이력 보존(SetNull). CMI 는 자체 잔액만 갖고 거래로그를 안 주므로 웹이 원장을 둔다.
//  direction 으로 방향을 구분한다: in=유입(발행/보상) · out=유출(소각/상점) · transfer=유저 간 이체(순통화량 불변).
//  amount 는 항상 양수(방향은 direction 이 결정) → net 통화량 증감 = Σin − Σout.
model CoinAward {
  id             String   @id @default(uuid())
  profile_id     String? // 당사자 Profile.id (없을 수도)
  minecraft_uuid String? // 당사자 마크 UUID(profile 없을 때 식별용)
  amount         Int // 코인 양(항상 양수 — 방향은 direction)
  source         String // blueprint_download(+_bonus) | blueprint_reaction(+_bonus) | forum_reaction(+_bonus) | forum_weekly | block_place | playtime | admin_grant | shop_subscription | shop_nickname | shop_item | plot_claim | auction_buy | coin_transfer | ...
  direction      String   @default("in") // in=유입(faucet) | out=유출(sink/소각) | transfer=유저간 이체(net-zero)
  reason         String? // 상세(게시물 제목/사유/상대 등)
  delivered      Boolean  @default(true) // CMI 실제 입금 여부. false = 미접속/서버오프라인 등으로 미지급 → 접속 시 정산. (유출/이체는 이미 처리된 것이라 항상 true)
  created_at     DateTime @default(now())
  profile        Profile? @relation(fields: [profile_id], references: [id], onDelete: SetNull)

  @@index([created_at]) // 전체 기간 분석(시간당/평균)
  @@index([source, created_at]) // 소스별 분석
  @@index([profile_id, created_at]) // 유저별 획득/소비
  @@index([direction, created_at]) // 방향별(유입/유출/이체) 순환 집계
}

// 상점 결제 사가 가드 — CMI 차감(chargeCoins)과 웹 부여(구매기록/혜택) 사이에서 프로세스가 죽어도
// "차감됐는데 미부여"를 접속 시 자동 환불(reconcileStuckCharges → flushPendingCoins 정산)로 복구한다.
//   상태: charging(차감 시도, 결과 미확정) → charged(차감 '확인') → resolved(부여완료 또는 환불완료).
//   ⚠ 환불은 status='charged'(차감 확인된 건)만 대상 — 'charging'(차감 여부 불명)은 무상지급 위험이라 자동환불하지 않음.
//   refund_award_id 로 intent 당 환불 원장을 1개로 고정(이중 환불 방지). 구현: lib/shopChargeGuard.
model ChargeIntent {
  id              String    @id @default(uuid())
  profile_id      String? // 당사자 Profile.id (FK 아님 — 삭제돼도 정산 흔적 보존)
  minecraft_uuid  String // 환불 대상 마크 UUID
  amount          Int // 차감 시도 금액(코인)
  purpose         String // shop_item:<key> | shop_subscription | shop_nickname | shop_plot_slot
  status          String    @default("charging") // charging | charged | resolved
  refund_award_id String? // 환불로 생성한 CoinAward.id (중복 환불 방지)
  created_at      DateTime  @default(now())
  resolved_at     DateTime?

  @@index([status, created_at]) // 정산 스윕/조인 정산에서 미해결 건 스캔
  @@index([minecraft_uuid, status]) // 유저 접속 시 본인 미해결 건 조회
}

// 접근 차단 목록(blocklist) — 약관 위반으로 제재된 이용자의 부계정 재가입·우회(제재 회피)를 막는 식별자 대조.
// 인증(마크/Discord 연동·이메일 가입) 게이트에서 이 목록과 대조해 차단한다. 관계법령 검토: dev_notes/legal_blocklist_review.md
//  - 개인정보 최소수집: 원문(UUID/Discord ID/이메일) 미보관, HMAC-SHA256 해시만 저장(재식별 방지). 근거=개인정보보호법 제15조①6호(정당한 이익)+동의.
//  - linked_profile_id 는 FK 아님(관계 없음) — 회원 삭제돼도 차단은 유지되어야 하므로 cascade 대상에서 제외.
//  - 자의적 차단 방지(약관규제법 제6조): reason 필수. 비례성: expires_at 로 유기(기간제) 차단 지원.
//  - 유료가치 정산은 차단과 분리(settlement_note) — 전액 무보상 몰수 금지, 실손해 상계 후 환급 원칙.
model BlockedIdentity {
  id                String    @id @default(uuid())
  type              String // minecraft_uuid | discord_id | email
  value_hash        String // HMAC-SHA256(key, "<type>:<정규화 값>") — 원문 미보관(최소수집)
  value_hint        String? // 관리용 마스킹 힌트(예: "3f2a…9c1d", "ab***@gmail.com") — 재식별 최소화한 식별 보조
  reason            String // 차단 사유(필수) — 자의적 차단 방지(약관규제법 제6조 대응)
  category          String    @default("other") // abuse(욕설/혐오) | exploit(시스템 악용) | griefing(테러/그리핑) | cheat(핵/치트) | payment_fraud(결제사기) | evasion(제재 회피) | other
  blocked_by        String // 등록 관리자 creator_name(또는 'admin')
  linked_profile_id String? // 등록 시점 이 식별자와 연동돼 있던 Profile.id(자동 이용정지 대상). FK 아님(회원 삭제돼도 차단 유지).
  settlement_note   String? // 유료가치 정산 결정(환급/상계/해당없음 + 메모) — 차단과 분리된 별도 기록(전자상거래법·약관규제법 대응)
  expires_at        DateTime? // null=영구 차단. 미래시각=유기(기간제) 차단(비례성). 과거시각=만료(판정 시 무시).
  created_at        DateTime  @default(now())

  @@unique([type, value_hash]) // 같은 식별자 중복 등록 방지
  @@index([type, value_hash]) // 인증 게이트 조회(핫패스)
  @@index([created_at]) // 관리 목록 최신순
}
