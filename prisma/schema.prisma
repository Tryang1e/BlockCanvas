generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id              String             @id @default(uuid())
  role            String             @default("user")
  creator_name    String             @unique
  display_name    String?
  email           String?
  password        String?
  avatar_url      String?
  commission_open Boolean            @default(false)
  discord_id      String?
  created_at      DateTime           @default(now())
  portfolios      Portfolio?
  sections        PortfolioSection[]
  projects        Project[]
  messages        ContactMessage[]
  wip_logs        WipLog[]
  two_factor_secret   String?
  two_factor_enabled  Boolean            @default(false)
  privacy_consented   Boolean            @default(false)
  privacy_consented_at DateTime?
  privacy_consent_version String?            // 동의한 개인정보 처리방침 버전(예: v2). 현재 버전과 다르면 재동의 필요. null=레거시 동의.

  // --- Minecraft 연동 (MC_SER) ---
  minecraft_uuid      String?                @unique
  minecraft_username  String?
  last_seen_at        DateTime?              // 마지막 MC 접속(역동기화 role-sync). 스키매틱 90일 미접속 정리에 사용.
  world_quota_state   String                 @default("ok") // 월드 클라우드 쿼터: ok | warned(90%+) | locked(초과→전 월드 비활성, 다운로드/삭제만)
  verification        MinecraftVerification?
  minecraft_plots     MinecraftPlot[]
  minecraft_worlds    MinecraftWorld[]
  pending_transfers   PendingTransfer[]
  schematic_shares_owned    SchematicShare[]  @relation("SchematicShareOwner")    // 내가 남에게 공유한 폴더
  schematic_shares_received SchematicShare[]  @relation("SchematicShareGrantee")  // 나에게 공유된 폴더

  // --- Discord 연동 ---
  discord_username     String?
  discord_verification DiscordVerification?
  linked_account       LinkedAccount?
}

model Portfolio {
  creator_id    String  @id
  headline      String?
  about_text    String?
  banner_url    String?
  contact_email String?
  footer_title  String?
  footer_subtitle String?
  patreon_url   String?
  twitter_url   String?
  youtube_url   String?
  instagram_url String?
  sns_settings  String? // Store JSON string or use separate fields
  theme_bg_color String? @default("#222222")
  theme_bg_effect String? @default("none")
  is_published  Boolean @default(true)
  creator       Profile @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([is_published]) // explore: 공개 포트폴리오 필터
}

model PortfolioSection {
  id           String    @id @default(uuid())
  creator_id   String
  name         String
  sort_order   Int       @default(0)
  created_at   DateTime  @default(now())
  section_type String    @default("image_grid")
  content      String?
  show_title   Boolean   @default(true)
  is_visible   Boolean   @default(true)
  animation_type String  @default("fade-in")
  creator      Profile   @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([creator_id]) // 크리에이터별 섹션 조회
}

model Project {
  id            String            @id @default(uuid())
  creator_id    String
  title         String
  description   String?
  thumbnail_url String?
  content       String? // JSON string
  category_id   String?
  created_at    DateTime          @default(now())
  section_id    String?
  sort_order    Int               @default(0)
  youtube_url   String?
  is_published  Boolean           @default(false)
  view_count    Int               @default(0)
  creator       Profile           @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  section       PortfolioSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)
  widgets       ProjectWidget[]
  wip_logs      WipLog[]

  @@index([creator_id])                 // 크리에이터별 프로젝트 조회
  @@index([section_id])                 // 섹션별 프로젝트 조회
  @@index([is_published, created_at])   // explore: 공개 프로젝트 최신순
}

model ProjectWidget {
  id         String  @id @default(uuid())
  project_id String
  type       String
  content    String? // JSON string
  sort_order Int     @default(0)
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id]) // 프로젝트별 위젯 조회
}

model SiteSetting {
  key        String   @id
  value      String   // JSON string
  updated_at DateTime @updatedAt
}

model Category {
  id         String    @id @default(uuid())
  name       String    @unique
  slug       String    @unique
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  admin_name String
  action     String
  target_id  String?
  details    String?
  created_at DateTime @default(now())

  @@index([created_at]) // 감사 로그 최신순 조회
}

model CreatorLog {
  id           String   @id @default(uuid())
  creator_name String
  action       String
  target_id    String?
  details      String?
  created_at   DateTime @default(now())

  @@index([creator_name, created_at]) // 크리에이터별 활동 로그 최신순
}

model ContactMessage {
  id           String   @id @default(uuid())
  creator_id   String
  name         String
  email        String
  message      String
  is_read      Boolean  @default(false)
  reply        String?
  replied_at   DateTime?
  reply_read   Boolean  @default(false)
  sender_name  String?
  created_at   DateTime @default(now())
  creator      Profile  @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([creator_id, created_at]) // 크리에이터별 메시지함 최신순
  @@index([email, created_at])      // 이메일 기준 레이트리밋 조회
}

model WipLog {
  id          String   @id @default(uuid())
  creator_id  String
  title       String
  description String?
  media_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  project_id  String?
  profile     Profile  @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([creator_id])
  @@index([project_id]) // 프로젝트별 WIP 로그 조회
  @@index([created_at]) // explore: 전체 WIP 로그 최신순
}

// ============================================================
//  Minecraft 연동 (MC_SER) — 웹↔마인크래프트 서버 영토 연동
// ============================================================

// 웹 대시보드에서 발급한 1회용 6자리 인증코드. 인게임 /웹연동 <코드> 로 소비된다.
model MinecraftVerification {
  id          String   @id @default(uuid())
  profile_id  String   @unique
  code        String   @unique // 6자리 난수. @unique 로 코드 충돌(엉뚱한 계정 연동) 차단.
  created_at  DateTime @default(now())
  profile     Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

// 인게임 플롯의 웹측 캐시. syncMyPlots() 가 Spigot /api/plot/list 응답으로 upsert 한다.
// NOTE: id 는 PlotSquared 플롯 ID 문자열(예: "1;2"). 현재 단일 월드 가정.
//       멀티 월드로 확장 시 (world, id) 복합키로 바꾸고 Java/액션도 함께 수정해야 한다.
model MinecraftPlot {
  id              String   @id
  owner_id        String
  world           String   @default("world")
  alias           String?
  members         String?  // JSON 배열(임시 add 권한 UUID들)
  trusted_players String?  // JSON 배열(영구 trust 권한 UUID들)
  center_x        Int?     // 플롯 중심 월드 X (Dynmap 임베드용)
  center_z        Int?     // 플롯 중심 월드 Z (Dynmap 임베드용)
  auction_price   Float?   // 경매 매물 가격(코인). null = 경매중 아님 (인게임에서 역동기화)
  updated_at      DateTime @updatedAt
  owner           Profile  @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id]) // 소유자별 플롯 조회
}

// 웹에서 신청한 소유권 양도 요청 기록. 실제 권한 변경은 인게임 /웹연동 수락 으로 완료된다(2FA).
// 인게임 수락 결과는 Phase 2 역방향 webhook 으로 status 가 갱신된다.
model PendingTransfer {
  id          String   @id @default(uuid())
  plot_id     String
  from_id     String   // 양도를 신청한 프로필
  target_name String   // 인게임 대상 닉네임
  status      String   @default("pending") // pending | accepted | rejected | expired
  created_at  DateTime @default(now())
  from        Profile  @relation(fields: [from_id], references: [id], onDelete: Cascade)

  @@index([from_id, status]) // 내 양도 신청 현황 조회
}

// 웹에서 발급한 1회용 Discord 연동 코드. 봇 /연동 <코드> 로 소비된다.
model DiscordVerification {
  id          String   @id @default(uuid())
  profile_id  String   @unique
  code        String   @unique // @unique 로 코드 충돌(엉뚱한 계정 연동) 차단
  created_at  DateTime @default(now())
  profile     Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

// 이메일/비밀번호 회원가입 대기열. 인증 메일의 토큰 링크를 클릭하면 Profile(role=user) 로 승격된다.
// 인증 전에는 Profile 을 만들지 않아(핸들 선점·미인증 계정 방지) 토큰 소비 시점에 생성한다.
model EmailVerification {
  id            String   @id @default(uuid())
  email         String   @unique // 동일 이메일 재가입 시 upsert 로 토큰 갱신
  password_hash String
  display_name  String?  // 가입 시 입력한 닉네임. 인증 완료 시 Profile.display_name + 핸들 기준으로 사용.
  token         String   @unique
  created_at    DateTime @default(now())
}

// 비밀번호 재설정(비밀번호 찾기) 1회용 토큰. 메일 링크의 토큰으로 새 비밀번호를 설정하면 소비된다.
// 계정 존재 여부 노출 방지를 위해 요청 액션은 항상 동일한 성공 응답을 반환한다(여기 레코드 유무는 비공개).
model PasswordReset {
  id         String   @id @default(uuid())
  email      String   @unique // 동일 이메일 재요청 시 upsert 로 토큰 갱신
  token      String   @unique
  created_at DateTime @default(now())
}

// auth.craftopia.work 독립 연동 허브의 신원(크리에이터 Profile 과 별개 — 누구나 Discord↔Minecraft 묶음).
model LinkedAccount {
  id                 String   @id @default(uuid())
  discord_id         String?  @unique
  discord_username   String?
  minecraft_uuid     String?  @unique
  minecraft_username String?
  profile_id         String?  @unique // 웹(크리에이터 Profile) 브리지
  profile            Profile? @relation(fields: [profile_id], references: [id], onDelete: SetNull)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

// 인게임 개인 월드(클라우드). Multiverse-Core 로 호스팅. MyIdea §2(클라우드 제공) — Builder's Refuge 스타일.
// 웹은 메타데이터/권한을 관리하고, 실제 생성·백업 등은 BlockCanvasLink 플러그인이 수행(추후 연동).
model MinecraftWorld {
  id              String    @id @default(uuid())
  owner_id        String
  name            String    // 표시 이름(사용자가 정한 월드 이름)
  world_key       String?   // {닉네임}_{월드이름} 의 sha256 해시(hex). mv_world(서버 폴더명)의 원본 — 폴더명에 닉/이름 노출 방지.
  source          String    @default("basic") // basic(기본 생성: 평지/야생) | import(.zip 업로드)
  mv_world        String?   // 서버상의 월드 폴더명(= w_<world_key 앞부분>). 프로비저닝 완료 후 채워짐.
  generator       String    @default("flat") // flat | wild | (커스텀 generator 문자열)
  icon            String?   // 월드 목록 아이콘 프리셋 키 (worldIcons.ts, 관리자 등록 블록 이미지)
  version         String?   // MC 버전 (예: "1.21.1")
  size_bytes      BigInt    @default(0) // 디스크 사용량(바이트). 쿼터 계산용. 액션 경계에서 Number 로 변환.
  border          Int       @default(3000) // 월드 보더 (청크 과확장 방지, MyIdea §2-6)
  flags           String?   // JSON: 게임룰/플래그 (mobSpawning, weather, time, blockPhysics, fluidSpread …)
  trusted_players String?   // JSON 배열 [{uuid,name}] — 초대 멤버 (MyIdea §2-5/2-10)
  status          String    @default("provisioning") // provisioning | active | archived(아카이브: 서버에서 내려감, Restore 가능)
  last_saved      DateTime?
  last_active_at  DateTime? // 마지막 사용(접속/열람) 시각. +30일 미사용=아카이브, +90일=영구삭제 (수명주기).
  last_backup_at  DateTime? // 백업 24h 1회 제한 (MyIdea §2-5)
  backup_path     String?   // 최신 백업/아카이브 zip 절대경로(복구용 = backups[0]).
  backups         String?   // JSON 배열 [{path,ts,bytes}] 최신순, 최대 5개(초과 시 가장 오래된 것 삭제). 날짜별 다운로드용.
  archived_at     DateTime? // 아카이브된 시각
  pending_transfer_to String?   // 양도 대기: 받는 사람 Profile.id (수락 시 owner_id 로 이전). null=대기 없음.
  pending_transfer_at DateTime? // 양도 요청 시각
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  owner           Profile   @relation(fields: [owner_id], references: [id], onDelete: Cascade)

  @@index([owner_id, status])       // 소유자별 월드 조회
  @@index([status, last_active_at]) // 수명주기 스윕(만료/삭제 대상 탐색)
}

// 스키매틱 폴더 공유 — owner 가 grantee 에게 자기 개인 스키매틱 폴더(= owner.minecraft_uuid)를 공유.
// 권한 레벨(월드 멤버 권한과 동일한 "권한 형식" 철학): view(보기/다운로드) | edit(+업로드/삭제).
// 인게임 //schem load 는 FAWE 전체공개라 세분화 불가 → 웹 공유만 권한 세분화(다운로드 후 본인 폴더 업로드로 인게임 사용).
model SchematicShare {
  id         String   @id @default(uuid())
  owner_id   String   // 폴더 소유자 Profile.id (실제 폴더 = owner.minecraft_uuid)
  grantee_id String   // 공유받는 사람 Profile.id (웹 로그인해 "공유받은 스키매틱"에서 접근)
  perm       String   @default("view") // view(보기/다운로드) | edit(+업로드/삭제)
  created_at DateTime @default(now())
  owner      Profile  @relation("SchematicShareOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  grantee    Profile  @relation("SchematicShareGrantee", fields: [grantee_id], references: [id], onDelete: Cascade)

  @@unique([owner_id, grantee_id]) // 한 사람당 한 폴더에 권한 하나
  @@index([grantee_id])            // 나에게 공유된 폴더 목록 조회
}
